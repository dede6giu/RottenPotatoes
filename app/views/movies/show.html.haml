%h1 Details about "#{@movie.title}"
%p{:style => "color: green"}= notice

#metadata 
  %ul#details 
    %li Rating: #{@movie.rating}
    %li Released on #{@movie.release_date.strftime('%F')}
  %div= @movie.description || "This movie does not have a set description."
%br

= link_to 'Edit this movie', edit_movie_path(@movie), :class => 'btn'
= link_to 'Back to movie list', movies_path, :class => 'btn btn-primary'

